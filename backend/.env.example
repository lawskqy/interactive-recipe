GEMINI_API_KEY=
PORT=8080
CHAT_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-2.5-flash-image
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional: enable background removal with a local ComfyUI installation.
COMFY_ENABLED=false
COMFY_URL=http://127.0.0.1:8188
# Legacy opt-in; the new preparation pipeline uploads/downloads images over HTTP
# and does not need an output directory. Setting this also enables segmentation.
COMFY_OUTPUT_DIR=
